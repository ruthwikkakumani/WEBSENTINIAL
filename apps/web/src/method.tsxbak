import { motion } from 'framer-motion'

const containerVariants = {
  hidden: { opacity: 0 },
  show: { opacity: 1, transition: { staggerChildren: 0.08 } },
}

const itemVariants = {
  hidden: { opacity: 0, y: 20 },
  show: { opacity: 1, y: 0, transition: { duration: 0.5, ease: [0.16, 1, 0.3, 1] as any } },
}

function Flow() {
  return (
    <motion.figure className="flow" initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} transition={{ duration: 0.5 }}>
      <svg viewBox="0 0 760 250" role="img" aria-labelledby="flow-title flow-desc">
        <defs>
          <marker id="arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0 1 L7 4 L0 7 Z" fill="#888" />
          </marker>
        </defs>
        <title id="flow-title">How a check moves</title>
        <desc id="flow-desc">
          The browser sends only an origin to Go. Go may contact the website on a public address, and sends only a
          domain name to Java. Java asks the RDAP registry over HTTPS.
        </desc>
        <Node x={16} y={28} w={150} h={64} title="This page" detail="Origin only" />
        <Node x={250} y={28} w={160} h={64} title="Go checker" detail="Pins the address" focal />
        <Node x={520} y={28} w={210} h={64} title="The website" detail="Ports 80 and 443" />
        <Node x={250} y={156} w={160} h={64} title="Java registry" detail="Name only" />
        <Node x={520} y={156} w={210} h={64} title="RDAP" detail="Public HTTPS only" />
        <Arrow x1={166} y1={60} x2={250} y2={60} />
        <Arrow x1={410} y1={60} x2={520} y2={60} />
        <Arrow x1={330} y1={92} x2={330} y2={156} />
        <Arrow x1={410} y1={188} x2={520} y2={188} />
      </svg>
    </motion.figure>
  )
}

function Node({ x, y, w, h, title, detail, focal = false }: { x: number; y: number; w: number; h: number; title: string; detail: string; focal?: boolean }) {
  return (
    <g>
      <rect x={x} y={y} width={w} height={h} rx={8} fill={focal ? '#3b82f6' : '#1e293b'} stroke={focal ? '#60a5fa' : '#334155'} strokeWidth={1.5} />
      <text x={x + 14} y={y + 28} fill={focal ? '#fff' : '#f1f5f9'} fontFamily="IBM Plex Sans, sans-serif" fontSize={15} fontWeight="600">
        {title}
      </text>
      <text x={x + 14} y={y + 48} fill={focal ? '#bfdbfe' : '#94a3b8'} fontFamily="IBM Plex Mono, monospace" fontSize={11}>
        {detail}
      </text>
    </g>
  )
}

function ScoreStrip() {
  return (
    <motion.figure className="score-strip" initial={{ opacity: 0, scaleX: 0 }} animate={{ opacity: 1, scaleX: 1 }} transition={{ duration: 0.6, ease: [0.16, 1, 0.3, 1] as any }} style={{ transformOrigin: 'left' }}>
      <svg viewBox="0 0 760 120" role="img" aria-label="Score bands">
        <rect x="8" y="44" width="176" height="10" rx="4" fill="#166534" />
        <rect x="184" y="44" width="266" height="10" rx="4" fill="#854d0e" />
        <rect x="450" y="44" width="302" height="10" rx="4" fill="#991b1b" />
        <text x="8" y="78" fontSize="13" fill="#f1f5f9" fontFamily="IBM Plex Sans, sans-serif" fontWeight="600">Safe under 24</text>
        <text x="184" y="78" fontSize="13" fill="#f1f5f9" fontFamily="IBM Plex Sans, sans-serif" fontWeight="600">Suspicious from 24</text>
        <text x="450" y="78" fontSize="13" fill="#f1f5f9" fontFamily="IBM Plex Sans, sans-serif" fontWeight="600">High risk at 59</text>
        <text x="8" y="32" fontSize="11" fill="#94a3b8" fontFamily="IBM Plex Mono, monospace">0</text>
        <text x="176" y="32" fontSize="11" fill="#94a3b8" fontFamily="IBM Plex Mono, monospace">24</text>
        <text x="442" y="32" fontSize="11" fill="#94a3b8" fontFamily="IBM Plex Mono, monospace">59</text>
        <text x="732" y="32" fontSize="11" fill="#94a3b8" fontFamily="IBM Plex Mono, monospace">100</text>
        <text x="96" y="104" fontSize="10" fill="#4ade80" fontFamily="IBM Plex Mono, monospace">Low risk</text>
        <text x="317" y="104" fontSize="10" fill="#facc15" fontFamily="IBM Plex Mono, monospace">Medium</text>
        <text x="601" y="104" fontSize="10" fill="#f87171" fontFamily="IBM Plex Mono, monospace">High</text>
      </svg>
    </motion.figure>
  )
}

function Arrow({ x1, y1, x2, y2 }: { x1: number; y1: number; x2: number; y2: number }) {
  const horizontal = y1 === y2
  return (
    <line
      x1={x1} y1={y1}
      x2={horizontal ? x2 - 8 : x2}
      y2={horizontal ? y2 : y2 - 8}
      stroke="#475569" strokeWidth={1.5}
      markerEnd="url(#arrow)"
    />
  )
}

const tableVariants = {
  hidden: { opacity: 0 },
  show: { opacity: 1, transition: { staggerChildren: 0.04 } },
}

const rowVariants = {
  hidden: { opacity: 0, x: -10 },
  show: { opacity: 1, x: 0, transition: { duration: 0.35, ease: [0.16, 1, 0.3, 1] } },
}

export function Method() {
  return (
    <motion.article className="method glass-panel" variants={containerVariants} initial="hidden" animate="show">
      <motion.p className="eyebrow" variants={itemVariants}>
        How a case file is made
      </motion.p>
      <motion.h1 variants={item}>What the number is, and what it is not.</motion.h1>
      <motion.p className="lede" variants={item}>
        WebSentinel is an advisory for someone who was sent a link. It is not a penetration test, and it is not a
        trained phishing detector. The number is a sum of documented rules plus a few extra observations. Neither part
        has been calibrated against a labelled corpus, so neither part is a detection rate.
      </motion.p>

      <motion.h2 variants={item}>What leaves the browser</motion.h2>
      <motion.p variants={item}>
        The page parses the address locally and posts only the origin, such as <code>https://example.com</code>. The
        path, query, and fragment are not sent. A username or password in the address is refused before anything is
        posted. The checker repeats that reduction, so a careless client cannot slip a secret through.
      </motion.p>

      <motion.h2 variants={item}>Who is allowed to connect</motion.h2>
      <motion.div variants={item}><Flow /></motion.div>
      <motion.p variants={item}>
        The browser never asks the website for its page. Go is the only program that may open that connection, and only
        after every resolved address has been checked as public. Java receives a domain name and talks to a registry.
      </motion.p>

      <motion.h2 variants={item}>Three programs, one job each</motion.h2>
      <motion.ol className="split" variants={item}>
        <motion.li key="page" variants={item}>
          <h3>This page</h3>
          <p>TypeScript. It explains the result, keeps recent case files visible, and never collects the page you might log in to.</p>
        </motion.li>
        <motion.li key="core" variants={item}>
          <h3>The core</h3>
          <p>Go. It is the only program allowed to contact the site. It checks the scheme, the certificate on port 443, DNS, redirects, and the shape of the hostname. It dials a specific public address after the lookup, and it refuses the connection if any answer is private, loopback, link-local, or a cloud metadata address.</p>
        </motion.li>
        <motion.li key="registry" variants={item}>
          <h3>The registry</h3>
          <p>Java. It receives a domain name, never a URL. It reads the IANA RDAP bootstrap and asks that registry for the creation date, the registrar, and DNSSEC. It will not follow a redirect to a non-public host.</p>
        </motion.li>
      </motion.ol>

      <motion.h2 variants={item}>How the number is made</motion.h2>
      <motion.div variants={item}><ScoreStrip /></motion.div>
      <motion.p variants={item}>The documented rules sit on the left. Extra observations can still move the verdict. Both numbers are shown so a judge can see which is which.</motion.p>

      <motion.h2 variants={item}>Documented rules</motion.h2>
      <motion.p variants={item}>
        These weights are the prototype rules. They are design choices. Safe is below 24, Suspicious is 24 up to but
        not including 59, and High risk is 59 or more. The age bands are mutually exclusive.
      </motion.p>
      <motion.table className="rules-table" variants={tableVariants} initial="hidden" animate="show">
        <thead>
          <tr><th>Signal</th><th>Points</th></tr>
        </thead>
        <motion.tbody>
          <motion.tr variants={rowVariants}><td>The link is not HTTPS</td><td className="num">+20</td></motion.tr>
          <motion.tr variants={rowVariants}><td>The certificate is missing or does not verify</td><td className="num">+20</td></motion.tr>
          <motion.tr variants={rowVariants}><td>A valid certificate expires in under 7 days</td><td className="num">+3</td></motion.tr>
          <motion.tr variants={rowVariants}><td>Registered under 7 days, 30 days, 6 months, or 1 year</td><td className="num">+35 / +25 / +15 / +8</td></motion.tr>
          <motion.tr variants={rowVariants}><td>Registry record updated under 7 days, or under 30 days</td><td className="num">+10 / +6</td></motion.tr>
          <motion.tr variants={rowVariants}><td>HTTPS and the delegation is DNSSEC-signed</td><td className="num">−3</td></motion.tr>
        </motion.tbody>
      </motion.table>
      <motion.p variants={item}>
        Under those rules the highest total is 85, from HTTP, an invalid certificate, a domain under 7 days old, and a
        registry update under 7 days old. An invalid certificate alone is 20, so it stays in Safe until another signal
        is added. The case file still lists that certificate as a warning. The advisory index is shown out of 100
        because extra observations can add to it. The documented rule total is always shown beside it.
      </motion.p>

      <motion.h2 variants={item}>Observations outside the rules</motion.h2>
      <motion.p variants={item}>These can move the advisory index and the verdict. They are marked in the case file, and they do not change the documented rule total.</motion.p>
      <motion.table className="rules-table" variants={tableVariants} initial="hidden" animate="show">
        <thead>
          <tr><th>Observation</th><th>Points</th></tr>
        </thead>
        <motion.tbody>
          <motion.tr variants={rowVariants}><td>A redirect pointed at a non-public address and was refused</td><td className="num">+30</td></motion.tr>
          <motion.tr variants={rowVariants}><td>A familiar brand word is not the registered domain</td><td className="num">+28</td></motion.tr>
          <motion.tr variants={rowVariants}><td>Look-alike letters from another alphabet</td><td className="num">+26</td></motion.tr>
          <motion.tr variants={rowVariants}><td>The name did not resolve</td><td className="num">+24</td></motion.tr>
          <motion.tr variants={rowVariants}><td>The registry lists a hold or deletion status</td><td className="num">+20</td></motion.tr>
          <motion.tr variants={rowVariants}><td>The address is a raw IP</td><td className="num">+18</td></motion.tr>
          <motion.tr variants={rowVariants}><td>The link leaves its registered domain</td><td className="num">+16</td></motion.tr>
          <motion.tr variants={rowVariants}><td>Internationalized name, fresh certificate, young domain, long hostname, old TLS</td><td className="num">+8 / +8 / +8 / +6 / +6</td></motion.tr>
        </motion.tbody>
      </motion.table>

      <motion.h2 variants={item}>What the checker will not do</motion.h2>
      <motion.ul className="limits" variants={item}>
        <motion.li variants={item}>It does not log in, post a password, or try an exploit.</motion.li>
        <motion.li variants={item}>It does not run the page&rsquo;s scripts or judge a logo.</motion.li>
        <motion.li variants={item}>It does not contact loopback, private networks, or metadata addresses, including when a redirect asks it to.</motion.li>
        <motion.li variants={item}>It only uses ports 80 and 443.</motion.li>
        <motion.li variants={item}>It does not claim an accuracy, a recall, or a false-negative rate. Those experiments have not been run.</motion.li>
      </motion.ul>

      <motion.h2 variants={item}>What a safe result still cannot say</motion.h2>
      <motion.p variants={item}>
        A valid certificate means the connection can be private. It does not mean the operator is the bank, the shop,
        or the friend who seemed to send the link. An old domain can still host a copy of a login page. A young
        legitimate business can collect the age penalty. Read the reasons, then confirm anything that asks for
        credentials by a channel you already trust.
      </motion.p>
    </motion.article>
  )
}