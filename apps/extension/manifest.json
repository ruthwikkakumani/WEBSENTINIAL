{
  "manifest_version": 3,
  "name": "WebSentinel",
  "version": "1.0.0",
  "description": "Check the public record of the site in this tab before you trust the link. Only the origin is sent.",
  "action": {
    "default_title": "Check this site",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:8080/*"]
}
